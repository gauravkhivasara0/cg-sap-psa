{
  "name": "psa",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch-psa-billing": "cds watch --open com.psa.billing.psabilling/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy psa --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.2.1",
    "@sap/cds-dk": "^10.2.0",
    "@sap/xssec": "^4",
    "pdf-lib": "^1.17.1"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/psa-billing"
  ]
}
